# ============================================
# Script Assistant 环境变量（可选）
# 推荐在网页中配置：打开后点右上角 ⚙️ 设置
# 此文件仅作为服务端兜底，非必填
# ============================================

# OpenAI 兼容 API 密钥
OPENAI_API_KEY=sk-your-api-key-here

# API 地址（留空使用 OpenAI 官方）
OPENAI_BASE_URL=https://api.deepseek.com

# 模型名称
OPENAI_MODEL=deepseek-v4-flash

# 本地 BERT 模型路径（可选，默认 backend/model/best_script_bert_model）
# 更换模型时只需指向新模型目录，无需修改代码
# SCRIPT_ASSISTANT_MODEL_PATH=/app/backend/model/best_script_bert_model